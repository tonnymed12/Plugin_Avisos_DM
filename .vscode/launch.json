{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run zpluginAviso",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/zpluginAviso/node_modules/@sap/html5-repo-mock/index.js",
      "cwd": "${workspaceFolder}/zpluginAviso",
      "env": {
        "PORT": "6004",
        "MOCK_LOOKUP_DIRS": "[\"zpluginAviso\"]",
        "run.config": "{\"handlerId\":\"ui5_flat_run_config_handler_id\",\"runnableId\":\"/home/user/projects/serviacero/plugins/zpluginAviso\"}"
      },
      "args": [
        "--standalone",
        "/serviacerocustompluginszpluginaviso/index.html",
        "--ui5",
        "{\"version\":\".\"}"
      ],
      "envFile": "${workspaceFolder}/zpluginAviso/.env1",
      "preLaunchTask": "Build zpluginAviso"
    }
  ]
}