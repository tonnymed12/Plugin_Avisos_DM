<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="serviacero.custom.plugins.zpluginaviso.controller.MainView" width="100%" height="100%">
		
        <Panel 
                id="panelPlugin"  
                width="100%"
                height="100%"
                expandable="false"
                expanded="false"
                accessibleRole="Region"
                backgroundDesign="Transparent"
                class="sapUiNoContentPadding">  

        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>tituloPlugin}"/>
                <ToolbarSpacer/>
            </OverflowToolbar>
        </headerToolbar>

            <content>
      <VBox class="sapUiSmallMargin" width="100%">
        <Label text="{i18n>labelTitulo}" required="true" labelFor="inpTitulo"/>
        <Input
          id="inpTitulo"
          placeholder="{i18n>placeholderTitulo}"
          maxLength="40"
          width="50%"
          liveChange=".onLiveChange"
          showValueHelp="true"
          valueHelpRequest=".onValueHelpTitulo"
          valueState="None"
          valueStateText="{i18n>valueStateTextTitulo}"/>

        <Label text="{i18n>labelPrioridad}" required="true" labelFor="cbPrioridad" class="sapUiSmallMarginTop"/>

        <ComboBox
            id="cbPrioridad"
            placeholder="{i18n>placeholderPrioridad}"
            selectedKey="1"
            selectionChange=".onSelectionChange"
            valueState="None"
            valueStateText="{i18n>valueStateTextPrioridad}">
            <items>
                <core:Item key="1" text="{i18n>prioridadAlta}"/>
                <core:Item key="2" text="{i18n>prioridadMedia}"/>
                <core:Item key="3" text="{i18n>prioridadBaja}"/>
            </items>
        </ComboBox>


        <Label text="{i18n>labelDescripcion}" required="true" labelFor="txtDescripcion" class="sapUiSmallMarginTop"/>
        <TextArea
          id="txtDescripcion"
          placeholder="{i18n>placeHolderPlano}"
          maxLength="200"
          growing="true"
          width="400px"
          height="200px"
          growingMaxLines="6"
          liveChange=".onLiveChange"
          valueState="None"
          value=""
          valueStateText="{i18n>valueStateTextDescripcion}"/>

        <Button
          text="{i18n>buttonGenerarAviso}"
          type="Emphasized"
          class="sapUiSmallMarginTop"
          press=".onEnviar"/>
      </VBox>
    </content>
	    </Panel>		
        
  
</mvc:View>